{
  "manifest_version": 3,
  "name": "Same Answer: Job Application Autofill",
  "version": "1.0.0",
  "description": "Answer a job application question once. Same Answer fills it in next time on Naukri and LinkedIn Easy Apply.",
  "key": "",
  "permissions": [
    "storage",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://zmymqvnkobdqbdlnwxjs.supabase.co/*"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.naukri.com/*"
      ],
      "js": [
        "src/content/naukri/selectors.js",
        "src/shared/storage.js",
        "src/content/naukri/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/shared/storage.js",
        "src/content/linkedin/selectors.js",
        "src/content/linkedin/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Same Answer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
